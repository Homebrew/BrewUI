{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",

      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash)",
      "Bash(git stash list)",
      "Bash(git stash show *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git config --list)",
      "Bash(git config --get *)",

      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swift *)",
      "Bash(swiftc *)",
      "Bash(simctl *)",

      "Bash(mint *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",

      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew --prefix *)",
      "Bash(brew --prefix)",

      "Bash(./scripts/bootstrap)",
      "Bash(./scripts/install-git-hooks)",
      "Bash(./scripts/postinstall)",
      "Bash(./scripts/pre-commit)",
      "Bash(scripts/bootstrap)",
      "Bash(scripts/install-git-hooks)",
      "Bash(scripts/postinstall)",
      "Bash(scripts/pre-commit)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(open *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(defaults read *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",

      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(brew install *)",
      "Bash(brew upgrade *)",
      "Bash(brew uninstall *)",
      "Bash(brew tap *)",
      "Bash(brew untap *)",
      "Bash(brew bundle *)"
    ]
  }
}
