{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nUntil this succeeds the app can't tell whether anything needs upgrading." : {
      "comment" : "Upgrades empty state under a failed check: brew's error, then why the list is empty",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nHasta que esto funcione, la app no puede saber si hay algo que actualizar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n检查成功后，应用才能确定是否有软件包需要升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n這項檢查成功完成後，App 才能判斷是否有套件需要升級。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nInnan detta lyckas kan appen inte avgöra om något behöver uppgraderas."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n확인에 성공해야 앱에서 업그레이드가 필요한 항목이 있는지 알 수 있습니다."
          }
        }
      }
    },
