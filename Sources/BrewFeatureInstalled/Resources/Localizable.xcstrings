{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nUntil this succeeds the app can't tell whether anything needs upgrading." : {
      "comment" : "Upgrades empty state under a failed check: brew's error, then why the list is empty",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n检查成功后，才能确定是否有软件包需要升级。"
          }
        }
      }
    },
    "%@ (linked)" : {
      "comment" : "Installed versions row; %@ is the version list, annotated when one keg is linked",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已链接）"
          }
        }
      }
    },
    "%@ — last check failed" : {
      "comment" : "Upgrades tab subtitle when cached upgrades are shown after a failed re-check",
