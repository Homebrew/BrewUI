        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果這些檔案並非你有意放置，它們可能干擾 Homebrew 配方的建置，可能需要刪除。"
          }
        }
      }
    },
    "Last checked" : {
      "comment" : "Doctor header: lead-in before a relative time, e.g. “Last checked 5 minutes ago”",
