      }
    },
    "Severity: %@" : {
      "comment" : "VoiceOver label prefixing an issue's severity name, e.g. Severity: Warning; %@ is filled with the localized value produced by DoctorSeverityStyle.displayName(_:).",
      "extractionState" : "manual",
      "localizations" : {
