    "Couldn't locate the brew executable. Install Homebrew, then refresh." : {
      "comment" : "Configuration tab, brew-not-found message",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo localizar el ejecutable de brew. Instala Homebrew y luego refresca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 brew 可执行文件。请安装 Homebrew 后刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 brew 執行檔。請安裝 Homebrew，然後重新整理。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att hitta det körbara programmet brew. Installera Homebrew och uppdatera sedan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "brew 실행 파일을 찾을 수 없습니다. Homebrew를 설치한 후 새로 고치세요."
          }
        }
      }
    },
