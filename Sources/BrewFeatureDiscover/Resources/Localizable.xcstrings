{
  "sourceLanguage": "en",
  "strings": {
    "%@ (linked)": {
      "comment": "Installed version label; %@ is the version, annotated when that keg is the linked one",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已链接）"
          }
        }
      }
    },
    "%@ installs (30d)": {
      "comment": "Discover row: 30-day install count; %@ is a formatted number",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 天安装 %@ 次"
          }
        }
      }
    },
    "%@ installs in 30 days": {
      "comment": "VoiceOver: install count over the last 30 days; %@ is the formatted count",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 天安装 %@ 次"
          }
        }
      }
    },
    "%lld packages match “%@”": {
      "comment": "Discover subhead, search result count",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld packages match “%2$@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个软件包与“%@”匹配"
          }
        }
      }
    },
    "1 package matches “%@”": {
      "comment": "Discover subhead, single search result",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个软件包与“%@”匹配"
          }
        }
      }
    },
    "30-day installs": {
      "comment": "Package detail row: Homebrew analytics install count",
