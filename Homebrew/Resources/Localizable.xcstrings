    "Homebrew is currently ignoring formulae, casks and commands from these taps because tap trust is required." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "由于需要信任 Tap，Homebrew 当前忽略了这些 Tap 中的 Formula、Cask 和命令。" } } } },
    "Homebrew is currently ignoring formulae, casks and commands" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Homebrew 当前忽略了以下 Formula、Cask 和命令" } } } },
    "from these taps because tap trust is required." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些内容来自需要信任的 Tap。" } } } },
