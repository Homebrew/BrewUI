{
  "sourceLanguage" : "en",
  "strings" : {
    "A report was saved after the app quit unexpectedly. You can send it to the Homebrew team on GitHub to help fix the problem, or discard it." : {
      "comment" : "Crash report dialog body",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用意外退出后已保存一份报告。你可以在 GitHub 上将报告发送给 Homebrew 团队，帮助修复问题，也可以丢弃报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 意外結束後已儲存一份報告。你可以透過 GitHub 將報告傳送給 Homebrew 團隊，協助修正問題，也可以將報告捨棄。"
          }
        }
      }
    },
    "Browse and search %lld+ packages" : {
