  "strings" : {
    "The entire app will use %@ the next time you open it. Reopening closes all current windows." : {"extractionState":"manual","generatesSymbol":false,"comment":"Language confirmation. %@ is the target language autonym, including the resolved system language.","localizations":{"en":{"stringUnit":{"state":"translated","value":"The entire app will use %@ the next time you open it. Reopening closes all current windows."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下次打开时，整个 App 将使用“%@”。重新打开会关闭当前所有窗口。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下次開啟時，整個 App 將使用「%@」。重新開啟會關閉目前所有視窗。"}}}},
